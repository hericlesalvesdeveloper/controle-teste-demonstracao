@page "{id:int}"
@model ControleTeste.Pages.Alteracoes.DetailsModel

<h1>Detalhes da Alteração</h1>

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Alteracao.AlteracaoId</dd>

    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@Model.Alteracao.NumeroAlteracao</dd>

    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Alteracao.Titulo</dd>

    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9">@Model.Alteracao.Descricao</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.Alteracao.Tipo</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Alteracao.Status</dd>

    <dt class="col-sm-3">Sistema</dt>
    <dd class="col-sm-9">@Model.Alteracao.Sistema</dd>

    <dt class="col-sm-3">Data Abertura</dt>
    <dd class="col-sm-9">@Model.Alteracao.DataAbertura</dd>

    <dt class="col-sm-3">Observação</dt>
    <dd class="col-sm-9">@Model.Alteracao.Observacao</dd>

    <dt class="col-sm-3">Menu/Sistema</dt>
    <dd class="col-sm-9">@Model.Alteracao.MenuSistema</dd>
</dl>

<a class="btn btn-secondary" href="/Alteracoes">Voltar</a>
<a class="btn btn-primary" href="/Alteracoes/Edit/@Model.Alteracao.AlteracaoId">Editar</a>
