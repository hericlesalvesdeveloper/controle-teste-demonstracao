@page
@model ControleTeste.Pages.Users.CreateModel
@{
    ViewData["Title"] = "Criar Usuário";
}

<div class="d-flex justify-content-center">
    <div class="card shadow-sm w-100" style="max-width:700px;">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <h2 class="mb-0">Criar Usuário</h2>
                <nav aria-label="breadcrumb" class="ms-auto">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/Users">Usuários</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Criar</li>
                    </ol>
                </nav>
            </div>

            <form method="post" class="row g-3">
                <div class="col-12">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" role="alert" id="validationSummary"></div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Input.Username" class="form-control form-control-lg" placeholder="Nome de usuário" autofocus />
                        <label asp-for="Input.Username">Nome de usuário</label>
                        <span class="text-danger small" asp-validation-for="Input.Username"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Input.Password" type="password" class="form-control form-control-lg" placeholder="Senha" />
                        <label asp-for="Input.Password">Senha</label>
                        <span class="text-danger small" asp-validation-for="Input.Password"></span>
                    </div>
                </div>

                <div class="col-12 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Input.IsAdmin" id="isAdminSwitch">
                        <label class="form-check-label" for="isAdminSwitch">Administrador</label>
                    </div>
                </div>

                <div class="col-12 d-flex gap-2 justify-content-end">
                    <a class="btn btn-outline-secondary" href="/Users">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-lg">Criar usuário</button>
                </div>
            </form>
        </div>
    </div>
</div>
