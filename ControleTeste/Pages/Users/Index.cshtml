@page
@model ControleTeste.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Usuários";
}

<h1>Usuários</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Criar novo usuário</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>IsAdmin</th>
            <th>Criado em</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model.Usuarios)
    {
        <tr>
            <td>@user.Id</td>
            <td>@user.Username</td>
            <td>@user.IsAdmin</td>
            <td>@user.CreatedAt.ToLocalTime()</td>
            <td>
                <a asp-page="Details" asp-route-id="@user.Id">Detalhes</a> |
                <a asp-page="Edit" asp-route-id="@user.Id">Editar</a> |
                <a asp-page="Delete" asp-route-id="@user.Id">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
