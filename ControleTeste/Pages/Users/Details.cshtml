@page "{id:int}"
@model ControleTeste.Pages.Users.DetailsModel
@{
    ViewData["Title"] = "Detalhes Usuário";
}

<h1>Detalhes</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Usuario.Id</dd>

        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.Usuario.Username</dd>

        <dt class="col-sm-2">IsAdmin</dt>
        <dd class="col-sm-10">@Model.Usuario.IsAdmin</dd>

        <dt class="col-sm-2">Criado em</dt>
        <dd class="col-sm-10">@Model.Usuario.CreatedAt.ToLocalTime()</dd>
    </dl>
</div>

<a asp-page="Index">Voltar</a>
