@page "{id:int}"
@model ControleTeste.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Excluir Usuário";
}

<h1>Excluir Usuário</h1>

<div>
    <h4>Tem certeza que deseja excluir este usuário?</h4>
    <dl class="row">
        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.Usuario.Username</dd>
    </dl>

    <form method="post">
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
