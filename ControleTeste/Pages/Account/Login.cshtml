@page
@model ControleTeste.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-card">
    <div class="login-brand">
        <h2><i class="bi bi-lock-fill"></i> ControleTeste</h2>
        <p class="text-muted">Acesse o sistema</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-custom">
            @foreach (var modelState in ViewData.ModelState.Values)
            {
                foreach (var error in modelState.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            }
        </div>
    }

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input asp-for="Input.Username" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Senha</label>
            <input asp-for="Input.Password" type="password" class="form-control" />
        </div>
        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Entrar</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Token))
    {
        <div class="alert alert-success mt-3">
            <p>Login bem-sucedido. Token JWT foi salvo em cookie 'AuthToken'.</p>
        </div>
    }
</div>
